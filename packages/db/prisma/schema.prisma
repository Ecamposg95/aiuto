// Esquema de AIUTO.
//
// Diseñado contemplando las cuatro fases del reporte de arquitectura; se construye
// sólo lo de la Fase 1. Migrar datos duele, migrar pantallas no.
//
// Regla que sostiene el producto: los campos de transparencia de una vacante son
// obligatorios EN LA COLUMNA, no en la validación del formulario. No se puede
// publicar una vacante incompleta ni queriendo.

generator client {
  provider = "prisma-client-js"
  // Ruta propia: en la salida standalone el motor de consultas no viaja si el
  // cliente vive en node_modules/.pnpm, que el bundler no rastrea.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enumeraciones

enum Rol {
  CANDIDATO
  STAFF_ADMIN
  STAFF_OPERADOR
  EMPRESA // reclutador de una empresa con cuenta; ve sólo lo de su empresa
}

enum EstadoEmpresa {
  PENDIENTE  // se registró sola y espera la aprobación del administrador
  APROBADA
  SUSPENDIDA
  RECHAZADA
}

enum EstadoLicencia {
  ACTIVA
  SUSPENDIDA
}

enum TipoAlerta {
  // Tres días hábiles desde la primera postulación sin que la empresa
  // contacte a nadie (máster prompt §11).
  EMPRESA_SIN_CONTACTO
}

enum EstadoAlerta {
  ABIERTA
  ATENDIDA
  DESCARTADA
}

enum NivelCandidato {
  ESTUDIANTE // estudiante o recién egresado
  EXPERIMENTADO
  GERENCIA // gerencia o dirección, o quien busca ese nivel
}

enum Modalidad {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum SeguroSocial {
  COMPLETO // se cotiza sobre el sueldo completo
  MIXTO    // se cotiza sobre una parte; el porcentaje se declara
}

enum Periodicidad {
  POR_HORA
  SEMANAL
  QUINCENAL
  MENSUAL
  ANUAL
}

enum EstadoVacante {
  BORRADOR
  ABIERTA
  CUBIERTA
  CERRADA
  EXPIRADA // la cerró la tarea diaria a los 60 días
}

enum EstadoPostulacion {
  RECIBIDA
  EN_REVISION
  ENTREVISTA
  CONTRATADA
  RECHAZADA
  VACANTE_CUBIERTA // la vacante se cubrió con alguien más
}

enum TipoSolicitud {
  CONTACTO  // formulario general
  CATEGORIA // interés en una de las seis categorías de consultoría
  EMPRESA   // una empresa que quiere publicar
}

enum EstadoSolicitud {
  NUEVA
  EN_PROCESO
  ATENDIDA
  CERRADA
}

enum EstadoAsesoria {
  NUEVA
  CONTACTADA
  VENDIDA
  EN_CURSO
  COLOCADO
  DESCARTADA
}

// ---------------------------------------------------------------- cuentas
// User, Account, Session y VerificationToken siguen el contrato del adaptador
// de Auth.js. `rol` es nuestro: con tres personas en el equipo, los permisos son
// un campo, no un sistema.

model User {
  id            String    @id @default(cuid())
  nombre        String?
  email         String    @unique
  emailVerified DateTime?
  imagen        String?
  rol           Rol       @default(CANDIDATO)

  // Sólo lo tienen las cuentas del equipo, creadas a mano con tools/crear-staff.
  // Los candidatos entrarán con Google o liga por correo en la Entrega 2.
  passwordHash  String?
  // El administrador la desactiva desde /panel/usuarios: no puede entrar y su
  // sesión abierta se corta en la siguiente petición. No se borra nada.
  desactivadoEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  cuentas   Account[]
  sesiones  Session[]
  perfil    CandidateProfile?

  empresasCreadas    Company[]
  vacantesCreadas    Vacante[]
  solicitudesACargo  Solicitud[]
  asesoriasSolicitadas SolicitudAsesoria[]
  acciones           AuditLog[]
  membresia          CompanyMember?
  mensajes           Mensaje[]
  notificaciones     Notificacion[]
  alertasAtendidas   Alerta[]

  @@index([rol])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- catálogo

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  nombre      String
  corto       String
  descripcion String
  color       String // base
  colorDark   String
  colorTint   String
  orden       Int

  vacantes    Vacante[]
  solicitudes Solicitud[]
  perfiles    CandidateProfile[]
}

// ---------------------------------------------------------------- candidato

model CandidateProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titular         String? // "Desarrollador backend", el encabezado del perfil
  resumen         String?
  nivel           NivelCandidato
  anosExperiencia Int            @default(0)
  telefono        String?

  // Código postal, no domicilio: permite calcular distancia a una vacante sin
  // custodiar dónde vive la gente. El cálculo de rutas llega después.
  codigoPostal String?

  habilidades    String[] @default([])
  linkedin       String?
  ligaPortafolio String?
  ligaVideo      String? // el pitch en video se aloja fuera por ahora
  cvUrl          String?
  disponibilidad String?

  // Roster preferencial: lo otorga la asesoría de empleabilidad al validar aptitudes.
  rosterPreferencial Boolean   @default(false)
  validadoEn         DateTime?

  // Consentimiento explícito para que las empresas a las que se postula vean
  // su CV, su pitch y sus evidencias (máster prompt §15). Sin él, la empresa
  // ve sólo lo que la persona escribió en la postulación.
  consentimientoEmpresasEn DateTime?

  categorias  Category[]
  experiencias Experiencia[]
  formaciones  Formacion[]
  evidencias   Evidencia[]
  guardadas    VacanteGuardada[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  postulaciones Postulacion[]

  @@index([nivel])
  @@index([rosterPreferencial])
}

// Trayectoria: tres a cinco logros por experiencia (máster prompt §8.2).
model Experiencia {
  id       String           @id @default(cuid())
  perfilId String
  perfil   CandidateProfile @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  puesto   String
  empresa  String
  // Texto libre ("mar 2021", "actual"): la gente no recuerda el día exacto.
  desde    String?
  hasta    String?
  logros   String[]         @default([])
  orden    Int              @default(0)

  @@index([perfilId])
}

model Formacion {
  id          String           @id @default(cuid())
  perfilId    String
  perfil      CandidateProfile @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  titulo      String
  institucion String
  anio        Int?
  orden       Int              @default(0)

  @@index([perfilId])
}

// Evidencias de competencias: repositorios, tableros, diseños (máster prompt §8.3).
model Evidencia {
  id       String           @id @default(cuid())
  perfilId String
  perfil   CandidateProfile @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  titulo   String
  url      String
  orden    Int              @default(0)

  @@index([perfilId])
}

model VacanteGuardada {
  perfilId  String
  perfil    CandidateProfile @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  vacanteId String
  vacante   Vacante          @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  creadoEn  DateTime         @default(now())

  @@id([perfilId, vacanteId])
}

// ---------------------------------------------------------------- empresa

model Company {
  id        String  @id @default(cuid())
  nombre    String
  slug      String  @unique
  sitio     String?
  ubicacion String?
  logoUrl   String?
  descripcion String?

  // Las que da de alta el equipo nacen aprobadas; las que se registran solas
  // nacen PENDIENTE y no publican hasta que el administrador las aprueba.
  estado         EstadoEmpresa @default(APROBADA)
  contactoNombre String?
  contactoCorreo String?
  contactoTel    String?

  verificada  Boolean @default(false)
  creadoPorId String?
  creadoPor   User?   @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  creadoEn DateTime @default(now())

  vacantes  Vacante[]
  miembros  CompanyMember[]
  licencias Licencia[]
  alertas   Alerta[]

  @@index([estado])
}

// Un usuario EMPRESA pertenece a una sola empresa.
model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puesto    String?
  creadoEn  DateTime @default(now())

  @@index([companyId])
}

// Licencia empresarial configurable (máster prompt §7.1). Sin precios a
// propósito: las tarifas no están autorizadas. Lo que limita es cuántas
// vacantes puede tener abiertas y hasta cuándo.
model Licencia {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacantesActivas Int
  iniciaEn        DateTime       @default(now())
  terminaEn       DateTime?
  estado          EstadoLicencia @default(ACTIVA)
  notaInterna     String?
  creadoEn        DateTime       @default(now())

  @@index([companyId, estado])
}

// ---------------------------------------------------------------- vacante

model Vacante {
  id         String   @id @default(cuid())
  slug       String   @unique
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  puesto      String
  descripcion String
  ubicacion   String
  modalidad   Modalidad

  // --- los campos que diferencian el producto: todos obligatorios ---

  sueldoMin     Int // en unidades enteras de la moneda
  sueldoMax     Int
  moneda        String       @default("MXN")
  periodicidad  Periodicidad

  seguroSocial    SeguroSocial
  seguroSocialPct Int // 100 cuando es COMPLETO

  prestaciones String
  horario      String

  conocimientos String[]

  // Lo que el máster prompt §7.1 pide además. Opcionales en la columna para no
  // invalidar las vacantes que ya existen; el formulario los pide.
  resultadosEsperados String? // el "Job to Be Done": qué tiene que lograr quien entre
  requisitos          String[] @default([]) // indispensables, a diferencia de conocimientos
  instrucciones       String? // cómo postularse, si hay algo además de "Aplicar"
  sueldoNeto          Boolean  @default(false) // el sueldo publicado es neto (después de impuestos)

  numEntrevistas     Int // cuántas entrevistas tiene el proceso
  diasCierreEsperado Int // en cuántos días espera cerrar la empresa

  // --- fin de los campos obligatorios ---

  estado      EstadoVacante @default(BORRADOR)
  publicadaEn DateTime?
  // Toda vacante nace con fecha de expiración: 30 días, ampliable una vez hasta
  // 60 contados desde la publicación (máster prompt §7.1).
  expiraEn    DateTime?
  ampliadaEn  DateTime?
  cerradaEn   DateTime?

  creadoPorId String?
  creadoPor   User?   @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  postulaciones Postulacion[]
  guardadas     VacanteGuardada[]
  alertas       Alerta[]

  @@index([estado, publicadaEn])
  @@index([categoryId])
  @@index([expiraEn])
}

// ---------------------------------------------------------------- postulación

model Postulacion {
  id        String  @id @default(cuid())
  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  // En la Entrega 1 se postula sin cuenta: basta el correo. En la Entrega 2 la
  // postulación queda ligada al perfil.
  candidateProfileId String?
  candidato          CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: SetNull)

  nombre   String
  correo   String
  telefono String?
  mensaje  String?
  cvUrl    String?

  estado      EstadoPostulacion @default(RECIBIDA)
  notaInterna String?

  // Contacto efectivo de la empresa: su primer mensaje dentro de AIUTO, o
  // cuando registra que contactó por otra vía. Es lo que apaga la alerta de
  // inactividad (máster prompt §11).
  contactadaEn DateTime?

  mensajes Mensaje[]

  // Token para consultar el estado sin cuenta, desde la liga del correo.
  tokenConsulta String @unique @default(cuid())

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Una postulación por persona y vacante.
  @@unique([vacanteId, correo])
  @@index([estado])
  @@index([candidateProfileId])
}

// ---------------------------------------------------------------- mensajes

// La conversación vive en la postulación: una por persona y vacante, y la
// empresa sólo puede escribir a quien se postuló a sus vacantes.
model Mensaje {
  id            String      @id @default(cuid())
  postulacionId String
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  autorId       String?
  autor         User?       @relation(fields: [autorId], references: [id], onDelete: SetNull)
  deEmpresa     Boolean
  texto         String
  leidoEn       DateTime?
  creadoEn      DateTime    @default(now())

  @@index([postulacionId, creadoEn])
}

// Avisos dentro de la plataforma. Las notificaciones de reclutamiento se quedan
// en AIUTO (máster prompt §19); el correo sólo avisa que hay algo nuevo.
model Notificacion {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo   String
  cuerpo   String?
  liga     String?
  leidaEn  DateTime?
  creadoEn DateTime  @default(now())

  @@index([userId, leidaEn])
}

// Alertas para el panel maestro. Una por tipo y vacante: si ya hay una, la
// tarea diaria la actualiza en vez de duplicarla.
model Alerta {
  id                   String       @id @default(cuid())
  tipo                 TipoAlerta
  vacanteId            String
  vacante              Vacante      @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primeraPostulacionEn DateTime
  postulados           Int
  estado               EstadoAlerta @default(ABIERTA)
  nota                 String?
  atendidaEn           DateTime?
  atendidaPorId        String?
  atendidaPor          User?        @relation(fields: [atendidaPorId], references: [id], onDelete: SetNull)
  creadoEn             DateTime     @default(now())
  actualizadoEn        DateTime     @updatedAt

  @@unique([tipo, vacanteId])
  @@index([estado, creadoEn])
}

// ---------------------------------------------------------------- solicitudes

model Solicitud {
  id   String        @id @default(cuid())
  tipo TipoSolicitud

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  nombre   String
  correo   String
  telefono String?
  empresa  String?
  mensaje  String

  origen String // qué página la generó

  estado        EstadoSolicitud @default(NUEVA)
  responsableId String?
  responsable   User?           @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  notaInterna   String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado, creadoEn])
  @@index([tipo])
}

model SolicitudAsesoria {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  nombre   String
  correo   String
  telefono String?
  mensaje  String?

  nivel NivelCandidato
  // El precio se congela al momento de solicitar: si mañana suben las tarifas,
  // lo que se le ofreció a esta persona sigue siendo lo que vio.
  // Sin precio publicado (máster prompt §7.1): queda nulo. Se conserva la
  // columna para las solicitudes que sí vieron uno.
  precioMostrado Int?
  moneda         String @default("MXN")

  estado      EstadoAsesoria @default(NUEVA)
  notaInterna String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado, creadoEn])
}

// ---------------------------------------------------------------- bitácora

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entidad   String
  entidadId String
  accion    String
  datos     Json?
  creadoEn  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([creadoEn])
}
