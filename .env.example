# Copiar a .env y ajustar. .env nunca se commitea.

# Base de datos. En local apunta al contenedor de docker-compose.
DATABASE_URL="postgresql://aiuto:aiuto_local@localhost:5432/aiuto?schema=public"

# Sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth — hace falta hasta la Entrega 2.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Correo transaccional. Proveedor por definir (pendiente 4 de la spec).
EMAIL_FROM="no-reply@aiuto.com.mx"
EMAIL_API_KEY=""

# A dónde llegan los avisos internos al equipo AIUTO.
EQUIPO_EMAIL="contacto@aiuto.com.mx"
