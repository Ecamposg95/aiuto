{
  "name": "aiuto",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @aiuto/web dev",
    "build": "pnpm --filter @aiuto/web build",
    "start": "pnpm --filter @aiuto/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aiuto/db migrate",
    "db:deploy": "pnpm --filter @aiuto/db deploy",
    "db:seed": "pnpm --filter @aiuto/db seed",
    "db:studio": "pnpm --filter @aiuto/db studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
